# =====================================================================
# MindCare AI — PRODUCTION Environment Configuration Template
#
# Copy to `.env` on the production host (used by docker-compose.prod.yml)
# and fill in real values. Never commit the real file. Every value marked
# "change-me" MUST be replaced with a unique, randomly generated secret —
# do not reuse development secrets or values from .env.example.
#
# See docs/architecture/deployment-guide.md for the full production
# checklist (TLS, domains, backups, monitoring) this file supports.
# =====================================================================

# --- General ---
COMPOSE_PROJECT_NAME=mindcare-ai
ENVIRONMENT=production
SITE_NAME=MindCare AI
FRONTEND_URL=https://app.mindcare.example.com
BACKEND_URL=https://app.mindcare.example.com

# --- Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-unique-random-50-char-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.mindcare.example.com
DJANGO_SETTINGS_MODULE=config.settings.production

# --- MySQL Database ---
MYSQL_DATABASE=mindcare_ai
MYSQL_USER=mindcare_user
MYSQL_PASSWORD=change-me-strong-unique-password
MYSQL_ROOT_PASSWORD=change-me-strong-unique-root-password
MYSQL_HOST=db
MYSQL_PORT=3306

# --- JWT Auth (djangorestframework-simplejwt) ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-separate-unique-signing-key

# --- Email (verification, password reset, notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=MindCare AI <no-reply@mindcare.example.com>

# --- Redis (cache, rate limiting, Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Celery (async: emails, AI analysis, reminders) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Hugging Face ---
AI_ANALYSIS_ENABLED=True
HUGGINGFACE_API_TOKEN=hf_xxx_optional_for_gated_models
HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
HF_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
HF_DEVICE=cpu
HF_SENTIMENT_NEUTRAL_THRESHOLD=0.6

# --- LibreChat Integration ---
LIBRECHAT_URL=https://chat.mindcare.example.com
LIBRECHAT_API_KEY=change-me
LIBRECHAT_JWT_SECRET=change-me-shared-with-librechat
LIBRECHAT_JWT_REFRESH_SECRET=change-me-shared-with-librechat
LIBRECHAT_MONGO_URI=mongodb://librechat_mongo:27017/LibreChat
LIBRECHAT_CREDS_KEY=change-me-32-byte-hex-key
LIBRECHAT_CREDS_IV=change-me-16-byte-hex-iv

# --- LibreChat SSO (MindCare as OIDC provider — see apps.users.oidc) ---
# Generate with: python manage.py generate_oidc_rsa_key
OIDC_RSA_PRIVATE_KEY="change-me-run-generate_oidc_rsa_key-management-command"
LIBRECHAT_OIDC_CLIENT_ID=librechat
LIBRECHAT_OIDC_CLIENT_SECRET=change-me-shared-with-librechat-openid-client-secret
LIBRECHAT_OIDC_REDIRECT_URI=https://chat.mindcare.example.com/oauth/openid/callback
# Explicit issuer — nginx terminates TLS and forwards X-Forwarded-Proto, and
# SECURE_PROXY_SSL_HEADER (production.py) trusts it for is_secure(), but the
# OIDC issuer is set explicitly anyway rather than relying on that trust
# boundary for something this security-sensitive.
OIDC_ISS_ENDPOINT=https://app.mindcare.example.com/o

# --- Frontend (Vite — baked into the static build at image-build time) ---
VITE_API_BASE_URL=https://app.mindcare.example.com/api/v1
VITE_LIBRECHAT_URL=https://chat.mindcare.example.com

# --- Security ---
CORS_ALLOWED_ORIGINS=https://app.mindcare.example.com
CSRF_TRUSTED_ORIGINS=https://app.mindcare.example.com,https://chat.mindcare.example.com
SECURE_SSL_REDIRECT=True
# Parent domain (leading dot) so the LibreChat SSO session cookie is valid
# across both the app and chat subdomains, e.g. ".mindcare.example.com".
SESSION_COOKIE_DOMAIN=.mindcare.example.com
RATE_LIMIT_LOGIN=5/min
RATE_LIMIT_DEFAULT=100/min

# --- Emergency / Crisis Resources ---
DEFAULT_CRISIS_COUNTRY=GH
