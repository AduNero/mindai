# =====================================================================
# LibreChat environment — separate from the root .env because LibreChat
# is a standalone Node.js app with its own config convention, not a
# Django app. Copy to `librechat/config/librechat.env` and fill in real
# values; docker-compose.yml (Phase 9) loads this file into the
# `librechat` service via `env_file`.
#
# Values marked "shared with root .env" MUST exactly match the
# corresponding LIBRECHAT_* / OIDC_* value in the project root .env —
# see setup_librechat_oidc_client (Django management command) for the
# OIDC client_id/secret this pairs with.
# =====================================================================

HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# --- Database ---
MONGO_URI=mongodb://librechat_mongo:27017/LibreChat

# --- Session / token secrets (shared with root .env) ---
JWT_SECRET=change-me-shared-with-librechat            # = LIBRECHAT_JWT_SECRET
JWT_REFRESH_SECRET=change-me-shared-with-librechat     # = LIBRECHAT_JWT_REFRESH_SECRET
CREDS_KEY=32-byte-hex-key-change-me                    # = LIBRECHAT_CREDS_KEY
CREDS_IV=16-byte-hex-iv-change-me                      # = LIBRECHAT_CREDS_IV

# --- Auth: MindCare AI is the only identity source ---
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true

# OpenID Connect — MindCare AI acts as the IdP (see apps.users.oidc and
# apps/users/management/commands/setup_librechat_oidc_client.py).
OPENID_CLIENT_ID=librechat                             # = LIBRECHAT_OIDC_CLIENT_ID
OPENID_CLIENT_SECRET=change-me-shared-with-librechat-openid-client-secret  # = LIBRECHAT_OIDC_CLIENT_SECRET
# LibreChat's OIDC client refuses HTTP issuers, so this is routed through a
# self-signed TLS proxy for local dev (see docker-compose.yml's oidc-proxy
# service). In production, point this at your real HTTPS issuer instead,
# e.g. https://app.mindcare.example.com/o — see .env.production.example's
# OIDC_ISS_ENDPOINT, which must match.
OPENID_ISSUER=https://oidc-proxy/o
# Path only (not a full URL) — LibreChat builds redirect_uri as
# DOMAIN_SERVER + OPENID_CALLBACK_URL. Must match LIBRECHAT_OIDC_REDIRECT_URI
# in the root .env exactly (DOMAIN_SERVER + this path).
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SCOPE="openid profile email"
OPENID_SESSION_SECRET=change-me-random-string
OPENID_BUTTON_LABEL=Continue with MindCare AI
# Skips LibreChat's own login screen and redirects straight to MindCare's
# OIDC authorize endpoint — the actual "embedded, no second login" behavior.
OPENID_AUTO_REDIRECT=true
OPENID_USE_PKCE=false

# --- Model provider(s) — set at least one so the chat actually responds. ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_KEY=sk-or-v1-...   # used by the "OpenRouter" custom endpoint in librechat.yaml
# NVIDIA_API_KEY=nvapi-...      # used by the "NVIDIA NIM" custom endpoint in librechat.yaml

# --- Search / RAG (disabled by default — see docker-compose.yml, keeps the stack lean) ---
SEARCH=false

# --- Misc ---
NODE_ENV=production
DEBUG_LOGGING=false
