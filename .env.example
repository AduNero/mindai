# =====================================================================
# MindCare AI — Environment Configuration Template
# Copy this file to `.env` in the project root and fill in real values.
# Never commit the real `.env` file.
# =====================================================================

# --- General ---
# Names Docker Compose's containers/images/network (e.g. "mindcare-ai-backend-1"
# instead of a name derived from whatever the project folder happens to be called).
COMPOSE_PROJECT_NAME=mindcare-ai
ENVIRONMENT=development                 # development | staging | production
SITE_NAME=MindCare AI
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# --- MySQL Database ---
MYSQL_DATABASE=mindcare_ai
MYSQL_USER=mindcare_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=db
MYSQL_PORT=3306

# --- JWT Auth (djangorestframework-simplejwt) ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-separate-signing-key

# --- Email (verification, password reset, notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=MindCare AI <no-reply@mindcare.ai>

# --- Redis (cache, rate limiting, Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Celery (async: emails, reminders) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Sentiment classifier (TF-IDF + logistic regression, trained on TweetEval) ---
AI_ANALYSIS_ENABLED=True                 # set False to run the API without a trained classifier artifact present
SENTIMENT_MODEL_ARTIFACT_PATH=           # optional override; defaults to apps/ai_engine/ml/artifacts/sentiment_tfidf_logreg.joblib
TWEETEVAL_COMMIT_SHA=4fbd22cd78421f05b1ecdb4fc5725bc7a7bd8f66

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False               # set True in production behind HTTPS
RATE_LIMIT_LOGIN=5/min
RATE_LIMIT_DEFAULT=100/min

# --- Emergency / Crisis Resources ---
DEFAULT_CRISIS_COUNTRY=GH               # ISO country code used as fallback for crisis resources
