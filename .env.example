# =====================================================================
# MindCare AI — Environment Configuration Template
# Copy this file to `.env` in the project root and fill in real values.
# Never commit the real `.env` file.
# =====================================================================

# --- General ---
# Names Docker Compose's containers/images/network (e.g. "mindcare-ai-backend-1"
# instead of a name derived from whatever the project folder happens to be called).
COMPOSE_PROJECT_NAME=mindcare-ai
ENVIRONMENT=development                 # development | staging | production
SITE_NAME=MindCare AI
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,oidc-proxy
DJANGO_SETTINGS_MODULE=config.settings.development

# --- MySQL Database ---
MYSQL_DATABASE=mindcare_ai
MYSQL_USER=mindcare_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=db
MYSQL_PORT=3306

# --- JWT Auth (djangorestframework-simplejwt) ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-separate-signing-key

# --- Email (verification, password reset, notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=MindCare AI <no-reply@mindcare.ai>

# --- Redis (cache, rate limiting, Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Celery (async: emails, AI analysis, reminders) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Hugging Face ---
AI_ANALYSIS_ENABLED=True                 # set False to run the API without torch/transformers installed
HUGGINGFACE_API_TOKEN=hf_xxx_optional_for_gated_models
HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
HF_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
HF_DEVICE=cpu                            # cpu | cuda
HF_SENTIMENT_NEUTRAL_THRESHOLD=0.6

# --- LibreChat Integration ---
LIBRECHAT_URL=http://librechat:3080
LIBRECHAT_API_KEY=change-me
LIBRECHAT_JWT_SECRET=change-me-shared-with-librechat
LIBRECHAT_JWT_REFRESH_SECRET=change-me-shared-with-librechat
LIBRECHAT_MONGO_URI=mongodb://librechat_mongo:27017/LibreChat
LIBRECHAT_CREDS_KEY=32-byte-hex-key-change-me
LIBRECHAT_CREDS_IV=16-byte-hex-iv-change-me

# --- LibreChat SSO (MindCare as OIDC provider — see apps.users.oidc) ---
# Generate with: python manage.py generate_oidc_rsa_key
OIDC_RSA_PRIVATE_KEY="change-me-run-generate_oidc_rsa_key-management-command"
LIBRECHAT_OIDC_CLIENT_ID=librechat
LIBRECHAT_OIDC_CLIENT_SECRET=change-me-shared-with-librechat-openid-client-secret
# Must match LibreChat's actual OpenID callback route for your deployed version.
LIBRECHAT_OIDC_REDIRECT_URI=http://localhost:3080/oauth/openid/callback
# LibreChat's OIDC client refuses HTTP issuers, so local dev routes it through
# a self-signed TLS proxy (see docker-compose.yml's oidc-proxy service and
# docker/oidc-proxy/). Leave unset for a setup with no such proxy — the
# issuer then falls back to being derived from the request.
OIDC_ISS_ENDPOINT=https://oidc-proxy/o

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_LIBRECHAT_URL=http://localhost:3080

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False               # set True in production behind HTTPS
# Production only — parent domain so the LibreChat SSO session cookie works
# across subdomains, e.g. ".mindcare.example.com". Leave unset in development.
SESSION_COOKIE_DOMAIN=
RATE_LIMIT_LOGIN=5/min
RATE_LIMIT_DEFAULT=100/min

# --- Emergency / Crisis Resources ---
DEFAULT_CRISIS_COUNTRY=GH               # ISO country code used as fallback for crisis resources
