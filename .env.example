# =====================================================================
# MindCare AI — Environment Configuration Template
# Copy this file to `.env` in the project root and fill in real values.
# Never commit the real `.env` file.
# =====================================================================

# --- General ---
# Names Docker Compose's containers/images/network (e.g. "mindcare-ai-backend-1"
# instead of a name derived from whatever the project folder happens to be called).
COMPOSE_PROJECT_NAME=mindcare-ai
ENVIRONMENT=development                 # development | staging | production
SITE_NAME=MindCare AI
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# --- MySQL Database ---
MYSQL_DATABASE=mindcare_ai
MYSQL_USER=mindcare_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=db
MYSQL_PORT=3306

# --- JWT Auth (djangorestframework-simplejwt) ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-separate-signing-key

# --- Email (verification, password reset, notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=MindCare AI <no-reply@mindcare.ai>

# --- Redis (cache, rate limiting, Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Celery (async: emails, AI analysis, reminders) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Hugging Face ---
AI_ANALYSIS_ENABLED=True                 # set False to run the API without torch/transformers installed
HUGGINGFACE_API_TOKEN=hf_xxx_optional_for_gated_models
HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
HF_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
HF_DEVICE=cpu                            # cpu | cuda
HF_SENTIMENT_NEUTRAL_THRESHOLD=0.6

# --- AI Chat Companion (see apps.chat.services.llm) ---
# Any OpenAI-API-compatible provider works — default is NVIDIA NIM
# (https://build.nvidia.com). Get a free API key there.
CHAT_LLM_API_KEY=change-me-nvapi-key
CHAT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# --- Google Sign-In (optional — blank means the button just doesn't render) ---
# Create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials — no client secret
# needed, the frontend uses Google Identity Services' ID-token flow.
# Same value on both sides: GOOGLE_CLIENT_ID is used server-side to
# verify tokens; VITE_GOOGLE_CLIENT_ID is baked into the frontend build.
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False               # set True in production behind HTTPS
RATE_LIMIT_LOGIN=5/min
RATE_LIMIT_DEFAULT=100/min

# --- Emergency / Crisis Resources ---
DEFAULT_CRISIS_COUNTRY=GH               # ISO country code used as fallback for crisis resources
